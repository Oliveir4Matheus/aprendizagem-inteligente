# ─────────────────────────────────────────────────────────────────────────────
#  A FRONTEIRA DO REPO
#
#  Versionado (raiz)  =  HARNESS  → como o sistema funciona e como o agente age
#  Ignorado (estudo/) =  CONTEÚDO → quem você é e o que você estudou
#
#  Regra única: se está dentro de estudo/, NUNCA sobe. Ponto.
#  Detalhes em AGENTS.md → "Onde escrever cada coisa".
# ─────────────────────────────────────────────────────────────────────────────

/estudo/

# código do MCP: baixado para dentro do workspace no setup (tem git próprio) — não versionar
/vendor/

# Credenciais NUNCA ficam no repo — a sessão do NotebookLM MCP vive em ~/.notebooklm-mcp-cli/
# (aqui só por garantia, caso alguém copie algo por engano)
**/auth.json
**/cookies.json
**/*.token

# rascunhos locais — prompts e recortes de trabalho da matéria em curso.
# É conteúdo, não harness: o que sobrevive daqui vai para estudo/atividades/.
/tmp/

# artefatos locais
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.tmp
